{
  "name": "@opengardenjs/core",
  "version": "0.3.0",
  "description": "The opengarden engine: a garden simulation and its WebGPU renderer, with no DOM and no Node.",
  "keywords": [
    "opengarden",
    "webgpu",
    "procedural",
    "tree",
    "garden"
  ],
  "license": "MIT",
  "homepage": "https://github.com/polo871209/opengarden/tree/main/packages/core#readme",
  "bugs": "https://github.com/polo871209/opengarden/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polo871209/opengarden.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@opengardenjs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webgpu": {
      "@opengardenjs/source": "./src/webgpu.ts",
      "types": "./dist/webgpu.d.ts",
      "default": "./dist/webgpu.js"
    },
    "./webgl": {
      "@opengardenjs/source": "./src/webgl.ts",
      "types": "./dist/webgl.d.ts",
      "default": "./dist/webgl.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74"
  }
}
